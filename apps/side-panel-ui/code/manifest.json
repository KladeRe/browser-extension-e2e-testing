{
  "manifest_version": 3,
  "name": "Side Panel Extension",
  "description": "Chrome extension that uses the side panel API",
  "version": "0.0.1",
  "permissions": [
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Side Panel"
  }
}